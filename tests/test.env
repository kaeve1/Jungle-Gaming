# Ambiente de TESTES isolado do de desenvolvimento: outro projeto Compose
# (containers, rede e volumes com prefixo jungle-gaming-test) e outras portas.
#   docker compose --env-file tests/test.env up -d --wait
#   docker compose --env-file tests/test.env run --rm integration
#   docker compose --env-file tests/test.env down -v   # apaga SÓ os volumes de teste
COMPOSE_PROJECT_NAME=jungle-gaming-test
POSTGRES_HOST_PORT=25432
KEYCLOAK_HOST_PORT=28080
API_HOST_PORT=28081

# Infrastructure API must not race the test-owned consumers on the shared input queue.
APP_ROLES=api,reference-worker

