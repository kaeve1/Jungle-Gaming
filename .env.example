# Valores locais de EXEMPLO. Não contêm segredos reais.
# Copie para .env e ajuste se necessário.

# Nome da instância nos logs. Opcional: na falta, usa o hostname (em containers,
# o ID do container). Cada execução ainda gera um ProcessID único para leases.
INSTANCE_ID=local-1
# Papéis implementados: api, reference-worker, consumer e outbox-publisher.
APP_ROLES=api,reference-worker,consumer,outbox-publisher
# debug, info, warn, error
LOG_LEVEL=info
# Prazo para conexões e verificações de início (banco, chaves do IdP, filas).
START_TIMEOUT=30s
# Prazo para concluir o trabalho em andamento no encerramento.
SHUTDOWN_TIMEOUT=20s
# Compose: deve exceder SHUTDOWN_TIMEOUT.
STOP_GRACE_PERIOD=30s

# ---- Persistência (composição Fx na etapa 6) ----
# DATABASE_URL deve usar wallet_app; nunca wallet_migrator ou postgres.
DATABASE_URL=postgres://wallet_app:local-example-app@postgres:5432/wallet?sslmode=disable
DB_MAX_CONNS=10
DB_OPERATION_TIMEOUT=20s
DB_LOCK_TIMEOUT=3s
DB_STATEMENT_TIMEOUT=5s
# Até 3 retentativas após erro com rollback conhecido; commit ambíguo não é retentado.
DB_MAX_RETRIES=3

# ---- API e identidade ----
HTTP_ADDRESS=:8080
# Compose: mantenha a porta interna igual à porta de HTTP_ADDRESS.
API_CONTAINER_PORT=8080
API_HOST_PORT=18081
OIDC_ISSUER=http://localhost:18080/realms/jungle-gaming
OIDC_JWKS_URL=http://keycloak:8080/realms/jungle-gaming/protocol/openid-connect/certs
OIDC_AUDIENCE=wallet-api
OIDC_INTERNAL_CLIENT=wallet-internal
# Somente ambiente local; URLs de IdP/SQS em produção exigem HTTPS.
ALLOW_INSECURE_LOCAL=true
SQS_ENDPOINT=http://sqs:4566
AWS_REGION=us-east-1
SQS_CREDENTIALS_FILE=/wallet-service-credentials/credentials

# ---- Infraestrutura (todos têm este mesmo padrão no compose.yaml) ----
POSTGRES_PASSWORD=local-example-postgres
WALLET_MIGRATOR_PASSWORD=local-example-migrator
WALLET_APP_PASSWORD=local-example-app
POSTGRES_HOST_PORT=15432

KC_ADMIN_PASSWORD=local-example-admin
KEYCLOAK_HOST_PORT=18080
KC_SECRET_WALLET_INTERNAL=local-example-wallet-internal-secret
KC_SECRET_PROVIDER_A=local-example-provider-a-secret
KC_SECRET_PROVIDER_B=local-example-provider-b-secret
KC_SECRET_PROVIDER_A_SHORT_LIVED=local-example-provider-a-short-lived-secret
KC_SECRET_NO_ROLES=local-example-no-roles-secret

# Credencial administrativa do emulador SQS (usada só pelo provisionamento).
SQS_ADMIN_ACCESS_KEY_ID=jg-local-sqs-admin
SQS_ADMIN_SECRET_ACCESS_KEY=local-example-sqs-admin-secret

# Etapa7: reference-worker retoma referências pendentes; consumer é a entrada SQS da etapa8
REFERENCE_TTL=10m
REFERENCE_BASE_DELAY=1s
REFERENCE_MAX_DELAY=1m



# Only a trusted internal gateway may publish; allowed providers are configured here.
CONSUMER_QUEUE=wager-transactions.fifo
CONSUMER_NAME=wager-consumer
CONSUMER_PROVIDERS=provider-a,provider-b
CONSUMER_CONCURRENCY=4



# Publisher outbox (etapa 9)
PUBLISHER_QUEUE=wallet-events.fifo
PUBLISHER_CONCURRENCY=4

CONSUMER_DLQ=wager-transactions-dlq.fifo


