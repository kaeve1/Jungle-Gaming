{
  "realm": "jungle-gaming",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "wallet-api",
      "name": "Wallet API (audiência dos tokens; não emite tokens)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false
    },
    {
      "clientId": "wallet-internal",
      "name": "Serviço interno de carteiras",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SECRET_WALLET_INTERNAL}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-wallet-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "wallet-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "provider-a",
      "name": "Provedor de jogos A",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SECRET_PROVIDER_A}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-wallet-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "wallet-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "provider_id", "claim.value": "provider-a", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Provedor de jogos B",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SECRET_PROVIDER_B}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-wallet-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "wallet-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "provider_id", "claim.value": "provider-b", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "provider-a-short-lived",
      "name": "SOMENTE TESTES: provider-a com token de 5s, para testar expiração",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SECRET_PROVIDER_A_SHORT_LIVED}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "attributes": { "access.token.lifespan": "5" },
      "protocolMappers": [
        {
          "name": "audience-wallet-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "wallet-api", "access.token.claim": "true", "id.token.claim": "false" }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "provider_id", "claim.value": "provider-a", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "no-roles",
      "name": "SOMENTE TESTES: identidade válida sem nenhum papel na wallet-api",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_SECRET_NO_ROLES}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-wallet-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "wallet-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "wallet-api": [
        { "name": "wallet:admin", "description": "Operações de carteira: abrir, ler, ledger, reconciliação" },
        { "name": "wagering:write", "description": "Enviar operações de aposta (provedores)" },
        { "name": "wagering:read", "description": "Consultar operações de aposta" }
      ]
    }
  },
  "users": [
    {
      "username": "service-account-wallet-internal",
      "enabled": true,
      "serviceAccountClientId": "wallet-internal",
      "clientRoles": { "wallet-api": ["wallet:admin", "wagering:read"] }
    },
    {
      "username": "service-account-provider-a",
      "enabled": true,
      "serviceAccountClientId": "provider-a",
      "clientRoles": { "wallet-api": ["wagering:write", "wagering:read"] }
    },
    {
      "username": "service-account-provider-b",
      "enabled": true,
      "serviceAccountClientId": "provider-b",
      "clientRoles": { "wallet-api": ["wagering:write", "wagering:read"] }
    },
    {
      "username": "service-account-provider-a-short-lived",
      "enabled": true,
      "serviceAccountClientId": "provider-a-short-lived",
      "clientRoles": { "wallet-api": ["wagering:write", "wagering:read"] }
    },
    {
      "username": "service-account-no-roles",
      "enabled": true,
      "serviceAccountClientId": "no-roles"
    }
  ]
}
